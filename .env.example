# ==============================================================================
# The Hyper-Local Restaurant Menu & Allergen Digitizer - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Option 1: Google Gemma / PaliGemma 2 via Hugging Face Inference API / Router
# Recommended for Gemma Family Multimodal Vision (DocVQA fine-tuned)
# ------------------------------------------------------------------------------
HUGGINGFACE_API_KEY=your_huggingface_api_token_here
GEMMA_API_URL=https://router.huggingface.co/hf-inference/models/google/paligemma2-10b-pt-448

# ------------------------------------------------------------------------------
# Option 2: Google Gemini Multimodal Vision API (Google AI Studio)
# Fast, low-latency multimodal alternative
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_google_ai_studio_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# Option 3: OpenAI-Compatible Vision Endpoint (OpenRouter, Groq, vLLM, Ollama)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_or_openrouter_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_VISION_MODEL=google/paligemma2-10b-pt-448

# ------------------------------------------------------------------------------
# Autonomous Fallback Engine:
# If no API keys are provided above, the application automatically runs in
# Autonomous Local RAG & Culinary Vision mode with 100% functionality!
# ------------------------------------------------------------------------------
